{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/session-context.mjs\"",
            "timeout": 15,
            "additionalContextLimit": 1000,
            "statusMessage": "Reading workspace context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/codex-hooks.mjs\" snapshot",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/codex-hooks.mjs\" format",
            "timeout": 30,
            "statusMessage": "Formatting changed files"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/codex-hooks.mjs\" openapi",
            "timeout": 120,
            "statusMessage": "Checking OpenAPI contract"
          }
        ]
      }
    ]
  }
}
