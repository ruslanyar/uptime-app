            "type": "object",
            "required": [
                "interval_seconds",
                "url"
            ],
            "properties": {
                "interval_seconds": {
                    "type": "integer",
                    "maximum": 86400,
                    "minimum": 60,
                    "example": 60
                },
                "url": {
                    "type": "string",
                    "maxLength": 2048,
                    "example": "https://example.com"
                }
